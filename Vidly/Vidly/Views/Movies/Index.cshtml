@model Vidly.ViewModels.MoviesListViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Movies</h1>


@if (Model.Movies.Count < 1)
{
    <p class="alert alert-warning">There are no movies to display.</p>
}
else
{

    <div class="card mb-3">
        <h5 class="card-header"><strong>@(Model.Movies.Count == 1 ? "Movie" : "Movies" )</strong></h5>
        <ul class="list-group list-group-flush">

            @foreach (var movie in Model.Movies)
            {
                <li class="list-group-item">
                    @Html.ActionLink(movie.Name, "Details", "Movies", new { id = movie.Id }, new { @class = "card-link" })
                </li>

            }
        </ul>
    </div>


}


